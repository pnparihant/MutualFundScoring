# Copy to .env and fill in for your environment. Never commit the real .env.
#
# The two endpoint URLs are treated as credentials: they are redacted out of
# every log line and every error message the API can return (see the SECRET
# HYGIENE note in code/data_sources.py).

# ---------------------------------------------------------------------------
# Upstream feeds
# ---------------------------------------------------------------------------
# Full request URLs for the scheme-master and risk-metrics feeds, including any
# query string or token they require.
#
# Leave either unset to serve that feed from its local snapshot in data/
# instead. That is a permanent supported mode -- the whole backend runs with no
# network access -- and /api/status reports "fixture" vs "live" per feed.
SCHEME_MASTER=
RISK=

# Base URL for CMOTS's per-scheme Historical NAV endpoint, up to and including
# .../HistoricalNAV (no trailing scheme-specific path segments). Powers the
# dashboard's on-demand "date-wise return" feature (POST
# /api/returns/point-to-point). Leave unset to disable that feature -- there is
# no local-fixture fallback for it, unlike SCHEME_MASTER/RISK above.
HISTORICAL_NAV_URL=

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# development | production. In production the localhost CORS origins are
# dropped and POST /api/refresh refuses to run without REFRESH_TOKEN set.
APP_ENV=development

# Shared secret for POST /api/refresh, sent as the X-Refresh-Token header.
# Required in production; optional locally.
REFRESH_TOKEN=

# Comma-separated browser origins allowed to call this API, e.g.
# https://your-dashboard.example.com,https://www.your-dashboard.example.com
EXTRA_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Optional tuning (defaults shown)
# ---------------------------------------------------------------------------
# Daily refresh time.
REFRESH_HOUR=6
REFRESH_MINUTE=30
REFRESH_TZ=Asia/Kolkata

# Per-request timeout, seconds.
API_TIMEOUT_SECONDS=60

# Reject a feed response with fewer rows than this -- a truncated universe
# silently shifts every fund's peer-relative score, so it fails loudly.
API_MIN_ROWS=100

# Set false ONLY for an internal endpoint behind a private CA.
API_VERIFY_SSL=true
