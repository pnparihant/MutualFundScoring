# Deployment configuration for docker compose. Copy to .env and complete.
#   cp .env.example .env
#
# The real .env is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# Hostnames -- both are required
# ---------------------------------------------------------------------------
# The API as the user's BROWSER will reach it. Baked into the dashboard bundle
# at build time, so changing it needs `docker compose up -d --build`.
API_PUBLIC_URL=https://mf-scoring-api-uat.arihantcapital.com

# The dashboard's own public URL. Passed to the API as EXTRA_CORS_ORIGINS; if it
# does not match the address in the browser's URL bar exactly (scheme, host and
# port), every API call is blocked by CORS.
DASHBOARD_PUBLIC_URL=https://mf-scoring-uat.arihantcapital.com

# ---------------------------------------------------------------------------
# Upstream feeds
# ---------------------------------------------------------------------------
# The scheme-master and risk-metrics endpoints, taken from Section 3.1 of the
# deployment requirements document. They are deliberately not written into this
# file: it is committed to the repository, and the application treats these URLs
# as credentials -- they are stripped out of every log line and every error
# message the API can return.
#
# Leave either blank to serve that feed from the snapshot baked into the image
# instead. The service still starts, and /api/status will report that feed as
# "fixture" rather than "live".
SCHEME_MASTER=
RISK=

# Base URL for CMOTS's per-scheme Historical NAV endpoint, up to and including
# .../HistoricalNAV. Powers the dashboard's on-demand "date-wise return"
# feature. Leave blank to disable that feature -- there is no fixture fallback
# for it, unlike the two feeds above.
HISTORICAL_NAV_URL=

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Shared secret for POST /api/refresh, sent as the X-Refresh-Token header.
# Generate a fresh value on the server:  openssl rand -base64 48
REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Daily refresh time, IST.
REFRESH_HOUR=6
REFRESH_MINUTE=30

# Host ports. Both bind to 127.0.0.1 by default so nothing is exposed directly
# to the network; nginx or the load balancer proxies to them.
# Chosen to avoid 8000/8080/8642, already in use by other projects on this server.
API_BIND=127.0.0.1
API_PORT=9000
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=9080

# Set to false ONLY if CMOTS presents a certificate from a private CA.
API_VERIFY_SSL=true
